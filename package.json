{
  "name": "poudlard-edt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm i --no-audit --no-fund --loglevel=error && npm run lint && (npm run server & npm run dev)",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "json-server db.json --port 3000",
    "test": "jest",
    "api": "json-server db.json --host 0.0.0.0 --port ${PORT:-3000}",
    "build:surge": "vite build && cp dist/index.html dist/200.html",
    "deploy": "npm run build:surge && surge ./dist poudlard-ynov.surge.sh"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-jest": "^30.5.2",
    "babel-plugin-transform-vite-meta-env": "^1.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "json-server": "^1.0.0-beta.15",
    "vite": "^8.3.6"
  }
}
